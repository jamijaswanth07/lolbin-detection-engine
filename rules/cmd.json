            "indicator": "certutil",
            "severity": "MEDIUM",
            "mitre_attack": "T1059.003"
        },
        {
            "id": "CMD003",
            "name": "CMD Launching MSHTA",
            "description": "Detects cmd.exe launching mshta.",
            "process": "cmd.exe",
            "indicator": "mshta",
            "severity": "MEDIUM",
            "mitre_attack": "T1059.003"
        },
        {
            "id": "CMD004",
            "name": "CMD Launching Regsvr32",
            "description": "Detects cmd.exe launching regsvr32.",
            "process": "cmd.exe",
            "indicator": "regsvr32",
