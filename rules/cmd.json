{
    "rules": [
        {
            "id": "CMD001",
            "name": "CMD Launching PowerShell",
            "description": "Detects cmd.exe launching PowerShell through the command line.",
            "process": "cmd.exe",
            "indicator": "powershell",
            "severity": "MEDIUM",
            "mitre_attack": "T1059.003"
        },
        {
            "id": "CMD002",
            "name": "CMD Launching Certutil",
            "description": "Detects cmd.exe launching certutil.",
